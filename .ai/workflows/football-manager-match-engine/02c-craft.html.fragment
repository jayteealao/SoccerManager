    .fragment-design-contract .dc-grid td { border: 1px solid oklch(0.90 0.008 250); padding: 6px 10px; text-align: center; }
    .fragment-design-contract .dc-grid th[scope="col"] { font-weight: 600; white-space: nowrap; }
    .fragment-design-contract .dc-rowhead { text-align: left; font-weight: 600; white-space: nowrap; }
    .fragment-design-contract .dc-grid td.is-on { color: oklch(0.55 0.17 250); }
    .fragment-design-contract .dc-mark-row { display: flex; gap: 20px; flex-wrap: wrap; align-items: flex-start; margin: 0 0 4px; }
    .fragment-design-contract .dc-mark { margin: 0; text-align: center; }
    .fragment-design-contract .dc-mark figcaption { font-size: 12px; color: oklch(0.48 0.02 250); margin-top: 6px; }
    .fragment-design-contract .dc-rows { display: flex; flex-direction: column; gap: 6px; }
    .fragment-design-contract .dc-row { border: 1px solid oklch(0.90 0.008 250); border-radius: 8px; padding: 8px 12px; }
    .fragment-design-contract .dc-row summary { cursor: pointer; display: flex; gap: 12px; align-items: baseline; justify-content: space-between; }
    .fragment-design-contract .dc-el { font-weight: 600; }
    .fragment-design-contract .dc-chips { display: inline-flex; gap: 6px; }
    .fragment-design-contract .dc-chip { font-size: 11px; border: 1px solid oklch(0.90 0.008 250); border-radius: 999px; padding: 1px 8px; color: oklch(0.48 0.02 250); white-space: nowrap; }
    .fragment-design-contract .dc-req { margin: 10px 0 8px; max-width: 78ch; }
    .fragment-design-contract .dc-toks { margin: 0; font-size: 12px; line-height: 1.9; }
    .fragment-design-contract .dc-toks code { background: oklch(0.96 0.006 250); border-radius: 4px; padding: 1px 5px; }
    .fragment-design-contract .dc-anti { margin: 6px 0; }
  </style>
  <script>
    (function () {
      var root = document.currentScript.closest('.fragment-design-contract');
      if (!root) return;
      window.dispatchEvent(new CustomEvent('sdlc:fragment-ready', {
        detail: { name: 'design-contract', artifact: 'design-contract', counts: { tokens: 36, states: 8, sizes: 1, themes: 2 } }
      }));
    })();

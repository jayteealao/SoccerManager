<section class="slice-dependency-graph">
  <h3>Two tracks after one root</h3>
  <svg viewBox="0 0 900 330" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Slice dependency graph: engine track and viewer track meeting at integration, with four deferred slices">
    <defs><marker id="sg-arrow" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto"><path d="M0,0 L8,4 L0,8 z" fill="currentColor"/></marker></defs>
    <g font-family="system-ui, sans-serif" font-size="11" fill="currentColor">
      <rect x="10" y="130" width="110" height="40" rx="6" fill="none" stroke="currentColor" stroke-width="2"/>
      <text x="65" y="154" text-anchor="middle" font-weight="600">1 engine-core</text>

      <text x="180" y="30" font-size="10" opacity="0.7">ENGINE TRACK</text>
      <rect x="160" y="40" width="130" height="40" rx="6" fill="none" stroke="currentColor"/><text x="225" y="64" text-anchor="middle">2 data-schemas</text>
      <rect x="320" y="40" width="120" height="40" rx="6" fill="none" stroke="currentColor"/><text x="380" y="64" text-anchor="middle">5 match-rules</text>
      <rect x="470" y="40" width="120" height="40" rx="6" fill="none" stroke="currentColor"/><text x="530" y="64" text-anchor="middle">6 tactics-and-ai</text>
      <rect x="620" y="40" width="110" height="40" rx="6" fill="none" stroke="currentColor"/><text x="675" y="64" text-anchor="middle">8 calibration</text>
      <rect x="470" y="100" width="120" height="34" rx="6" fill="none" stroke="currentColor"/><text x="530" y="121" text-anchor="middle">7 commentary</text>

      <text x="180" y="200" font-size="10" opacity="0.7">VIEWER TRACK</text>
      <rect x="160" y="210" width="130" height="40" rx="6" fill="none" stroke="currentColor"/><text x="225" y="234" text-anchor="middle">3 stream-protocol</text>
      <rect x="320" y="210" width="120" height="40" rx="6" fill="none" stroke="currentColor" stroke-width="2"/><text x="380" y="228" text-anchor="middle" font-weight="600">4 viewer-pitch</text><text x="380" y="242" text-anchor="middle" font-size="9">visible milestone</text>
      <rect x="470" y="210" width="120" height="40" rx="6" fill="none" stroke="currentColor"/><text x="530" y="234" text-anchor="middle">9 match-day</text>
      <rect x="620" y="180" width="110" height="34" rx="6" fill="none" stroke="currentColor"/><text x="675" y="201" text-anchor="middle">10 lineup-tactics</text>
      <rect x="620" y="230" width="110" height="34" rx="6" fill="none" stroke="currentColor"/><text x="675" y="251" text-anchor="middle">11 reports-recovery</text>

      <rect x="770" y="120" width="120" height="50" rx="6" fill="none" stroke="currentColor" stroke-width="2"/><text x="830" y="141" text-anchor="middle" font-weight="600">12 integration</text><text x="830" y="157" text-anchor="middle" font-size="9">full charter scenario</text>

      <line x1="120" y1="140" x2="158" y2="70" stroke="currentColor" marker-end="url(#sg-arrow)"/>
      <line x1="120" y1="160" x2="158" y2="225" stroke="currentColor" marker-end="url(#sg-arrow)"/>
      <line x1="290" y1="60" x2="318" y2="60" stroke="currentColor" marker-end="url(#sg-arrow)"/>
      <line x1="440" y1="60" x2="468" y2="60" stroke="currentColor" marker-end="url(#sg-arrow)"/>
      <line x1="590" y1="60" x2="618" y2="60" stroke="currentColor" marker-end="url(#sg-arrow)"/>
      <line x1="440" y1="75" x2="468" y2="110" stroke="currentColor" marker-end="url(#sg-arrow)"/>
      <line x1="290" y1="230" x2="318" y2="230" stroke="currentColor" marker-end="url(#sg-arrow)"/>
      <line x1="440" y1="230" x2="468" y2="230" stroke="currentColor" marker-end="url(#sg-arrow)"/>
      <line x1="530" y1="134" x2="530" y2="208" stroke="currentColor" stroke-dasharray="3 3" marker-end="url(#sg-arrow)"/>
      <line x1="590" y1="222" x2="618" y2="200" stroke="currentColor" marker-end="url(#sg-arrow)"/>
      <line x1="590" y1="238" x2="618" y2="246" stroke="currentColor" marker-end="url(#sg-arrow)"/>
      <line x1="730" y1="60" x2="768" y2="130" stroke="currentColor" marker-end="url(#sg-arrow)"/>
      <line x1="730" y1="197" x2="768" y2="150" stroke="currentColor" marker-end="url(#sg-arrow)"/>
      <line x1="730" y1="247" x2="768" y2="160" stroke="currentColor" marker-end="url(#sg-arrow)"/>
      <line x1="590" y1="80" x2="618" y2="185" stroke="currentColor" stroke-dasharray="3 3" marker-end="url(#sg-arrow)"/>

      <text x="10" y="295" font-size="10" opacity="0.7">DEFERRED (after the first release)</text>
      <rect x="10" y="302" width="150" height="24" rx="6" fill="none" stroke="currentColor" stroke-dasharray="4 3"/><text x="85" y="318" text-anchor="middle">extra-time-penalties</text>
      <rect x="175" y="302" width="130" height="24" rx="6" fill="none" stroke="currentColor" stroke-dasharray="4 3"/><text x="240" y="318" text-anchor="middle">experiment-flags</text>
      <rect x="320" y="302" width="150" height="24" rx="6" fill="none" stroke="currentColor" stroke-dasharray="4 3"/><text x="395" y="318" text-anchor="middle">scripting-runtime (RIM-6)</text>
      <rect x="485" y="302" width="110" height="24" rx="6" fill="none" stroke="currentColor" stroke-dasharray="4 3"/><text x="540" y="318" text-anchor="middle">distribution</text>
    </g>
  </svg>
</section>

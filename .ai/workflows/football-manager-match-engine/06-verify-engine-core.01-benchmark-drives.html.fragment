<figure class="verify-bench-drives">
  <figcaption>Benchmark drives against the 2,000 millisecond budget (one 90-minute match, one thread, seed 42, median of 5 timed matches)</figcaption>
  <svg viewBox="0 0 640 220" width="100%" role="img" aria-label="Three benchmark drives at 395, 398, and 397 milliseconds against a 2000 millisecond budget">
    <line x1="80" y1="20" x2="80" y2="180" stroke="currentColor" stroke-opacity="0.4"/>
    <line x1="80" y1="180" x2="620" y2="180" stroke="currentColor" stroke-opacity="0.4"/>
    <line x1="80" y1="30" x2="620" y2="30" stroke="#b42318" stroke-dasharray="6 4"/>
    <text x="616" y="24" font-size="12" text-anchor="end" fill="#b42318">budget 2000 ms</text>
    <rect x="140" y="150.4" width="90" height="29.6" fill="#1a7f37"/>
    <text x="185" y="144" font-size="12" text-anchor="middle">395 ms</text>
    <text x="185" y="198" font-size="12" text-anchor="middle">drive 1</text>
    <rect x="290" y="150.2" width="90" height="29.8" fill="#1a7f37"/>
    <text x="335" y="144" font-size="12" text-anchor="middle">398 ms</text>
    <text x="335" y="198" font-size="12" text-anchor="middle">drive 2</text>
    <rect x="440" y="150.2" width="90" height="29.8" fill="#1a7f37"/>
    <text x="485" y="144" font-size="12" text-anchor="middle">397 ms</text>
    <text x="485" y="198" font-size="12" text-anchor="middle">drive 3</text>
    <text x="74" y="34" font-size="11" text-anchor="end">2000</text>
    <text x="74" y="184" font-size="11" text-anchor="end">0</text>
    <text x="20" y="110" font-size="11" text-anchor="middle" transform="rotate(-90 20 110)">wall ms</text>
  </svg>
  <table class="verify-bench-fields">
    <thead><tr><th>Field</th><th>Drive 1</th><th>Drive 2</th><th>Drive 3</th><th>Pass criterion</th></tr></thead>
    <tbody>
      <tr><td>bench.match_wall_ms</td><td>395</td><td>398</td><td>397</td><td>at most 2000</td></tr>
      <tr><td>bench.cpu_wall_ratio</td><td>0.985</td><td>0.987</td><td>0.998</td><td>at least 0.9</td></tr>
      <tr><td>engine.ticks_per_s</td><td>683,544</td><td>678,392</td><td>680,101</td><td>reported</td></tr>
      <tr><td>bench.peak_mem_mb</td><td>5.05</td><td>5.06</td><td>5.05</td><td>reported</td></tr>
      <tr><td>machine.hash</td><td>74ca12fc08a4</td><td>74ca12fc08a4</td><td>74ca12fc08a4</td><td>12 hex characters</td></tr>
      <tr><td>build.hash</td><td>27d21f5-dirty</td><td>27d21f5-dirty</td><td>27d21f5-dirty</td><td>not empty, not unknown</td></tr>
      <tr><td>exit code</td><td>0</td><td>0</td><td>0</td><td>0</td></tr>
    </tbody>
  </table>
  <style>
    .verify-bench-drives figcaption { font-size: 0.9rem; margin-bottom: 8px; }
    .verify-bench-drives svg text { fill: currentColor; }
    .verify-bench-fields { width: 100%; border-collapse: collapse; font-size: 0.85rem; margin-top: 8px; }
    .verify-bench-fields th, .verify-bench-fields td { text-align: left; padding: 4px 8px; border-bottom: 1px solid rgba(127,127,127,0.25); }
  </style>
</figure>

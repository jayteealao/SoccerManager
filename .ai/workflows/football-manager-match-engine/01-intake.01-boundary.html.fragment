<section class="intake-boundary">
  <h3>System boundary the charter fixes</h3>
  <svg viewBox="0 0 720 220" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Manager, match engine, data contract, 2D viewer, and observability pipeline">
    <defs><marker id="ib-arrow" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto"><path d="M0,0 L8,4 L0,8 z" fill="currentColor"/></marker></defs>
    <g font-family="system-ui, sans-serif" font-size="13" fill="currentColor">
      <rect x="10" y="70" width="140" height="70" rx="8" fill="none" stroke="currentColor"/>
      <text x="80" y="98" text-anchor="middle">Manager</text>
      <text x="80" y="118" text-anchor="middle" font-size="11">lineup · tactics · substitutions</text>
      <rect x="220" y="40" width="180" height="130" rx="8" fill="none" stroke="currentColor" stroke-width="2"/>
      <text x="310" y="68" text-anchor="middle" font-weight="600">Match engine</text>
      <text x="310" y="90" text-anchor="middle" font-size="11">headless · any language</text>
      <text x="310" y="108" text-anchor="middle" font-size="11">tick: ball + 22 positions</text>
      <text x="310" y="126" text-anchor="middle" font-size="11">events · statistics</text>
      <text x="310" y="144" text-anchor="middle" font-size="11">fatigue · injuries · set pieces</text>
      <rect x="470" y="20" width="140" height="60" rx="8" fill="none" stroke="currentColor"/>
      <text x="540" y="45" text-anchor="middle">2D viewer</text>
      <text x="540" y="65" text-anchor="middle" font-size="11">HTML · CSS · JS</text>
      <rect x="470" y="130" width="140" height="60" rx="8" fill="none" stroke="currentColor"/>
      <text x="540" y="155" text-anchor="middle">Observability</text>
      <text x="540" y="175" text-anchor="middle" font-size="11">realism · performance · sanity</text>
      <line x1="150" y1="105" x2="218" y2="105" stroke="currentColor" marker-end="url(#ib-arrow)"/>
      <line x1="400" y1="80" x2="468" y2="55" stroke="currentColor" marker-end="url(#ib-arrow)"/>
      <line x1="400" y1="130" x2="468" y2="155" stroke="currentColor" marker-end="url(#ib-arrow)"/>
      <text x="434" y="58" text-anchor="middle" font-size="10">tick stream</text>
      <text x="434" y="160" text-anchor="middle" font-size="10">event stream</text>
      <text x="360" y="205" text-anchor="middle" font-size="11">Data contract (C4): the viewer draws what the engine computed; it invents no movement (C2).</text>
    </g>
  </svg>
</section>

<section class="fragment-review-dimension" data-artifact="review-dimension" data-rev="1">
<style>.fragment-review-dimension{font:14px/1.45 system-ui,sans-serif}.fragment-review-dimension .rd-bar{display:flex;gap:6px;flex-wrap:wrap;margin:0 0 10px}.fragment-review-dimension .rd-pill{border:1px solid #8886;border-radius:999px;padding:2px 10px;background:none;cursor:pointer;font:inherit}.fragment-review-dimension .rd-pill[aria-pressed=true]{background:#8883}.fragment-review-dimension table{border-collapse:collapse;width:100%}.fragment-review-dimension td,.fragment-review-dimension th{border-bottom:1px solid #8884;padding:4px 6px;text-align:left;vertical-align:top}.fragment-review-dimension .rd-sev{font-weight:600}.fragment-review-dimension details{margin:2px 0}</style>
<div class="rd-bar" role="group" aria-label="Severity filter"><button type="button" class="rd-pill" data-sev="ALL" aria-pressed="true">All</button><button type="button" class="rd-pill" data-sev="BLOCKER" aria-pressed="false">BLOCKER</button><button type="button" class="rd-pill" data-sev="HIGH" aria-pressed="false">HIGH</button><button type="button" class="rd-pill" data-sev="MED" aria-pressed="false">MED</button><button type="button" class="rd-pill" data-sev="LOW" aria-pressed="false">LOW</button><button type="button" class="rd-pill" data-sev="NIT" aria-pressed="false">NIT</button></div>
<ul class="rd-list">
<li data-sev="NIT"><details><summary><span class="rd-sev">NIT</span> SEC-5: Workflow evidence contains absolute local paths <code>.ai/workflows/football-manager-match-engine/:n/a</code> [deferred]</summary><p>About 189 lines of committed evidence carry C:\Users\&lt;name&gt; paths.</p><p><strong>Decision:</strong> Evidence files are generated workflow records; redacting them is outside this code diff and changes recorded evidence. Route to a redaction pass before publishing.</p></details></li>
</ul>
<script>(function(){var root=document.currentScript.closest('.fragment-review-dimension');var pills=root.querySelectorAll('.rd-pill');pills.forEach(function(p){p.addEventListener('click',function(){var s=p.getAttribute('data-sev');pills.forEach(function(q){q.setAttribute('aria-pressed',q===p?'true':'false')});root.querySelectorAll('.rd-list li').forEach(function(li){li.hidden=!(s==='ALL'||li.getAttribute('data-sev')===s)})})});window.dispatchEvent(new CustomEvent('sdlc:fragment-ready',{detail:{name:'review-dimension',artifact:'review-dimension',dimension:'security',counts:{findings:1,blockers:0}}}))})();</script>
</section>

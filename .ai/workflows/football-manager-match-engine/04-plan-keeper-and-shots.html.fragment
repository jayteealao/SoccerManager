    .fragment-plan .pl-risks { display: grid; gap: 8px; margin-top: 12px; }
    @media (max-width: 480px) { .fragment-plan .pl-files th:nth-child(3), .fragment-plan .pl-files td:nth-child(3) { display: none; } }

<section class="fragment-review" data-artifact="review" data-rev="1">
<style>.fragment-review{font:14px/1.45 system-ui,sans-serif}.fragment-review .fr-bar{display:flex;gap:6px;flex-wrap:wrap;margin:0 0 10px}.fragment-review .fr-pill{border:1px solid #8886;border-radius:999px;padding:2px 10px;background:none;cursor:pointer;font:inherit}.fragment-review .fr-pill[aria-pressed=true]{background:#8883}.fragment-review table{border-collapse:collapse;width:100%}.fragment-review td,.fragment-review th{border-bottom:1px solid #8884;padding:4px 6px;text-align:left;vertical-align:top}.fragment-review .fr-sev{font-weight:600}.fragment-review details{margin:2px 0}</style>

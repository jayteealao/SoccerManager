    .fragment-plan .pl-chip { display: inline-block; font-size: 0.7rem; padding: 1px 6px; border-radius: 999px; border: 1px solid currentColor; margin-right: 6px; opacity: 0.8; }
    .fragment-plan .pl-card { padding: 6px 0 4px 18px; opacity: 0.9; }
    .fragment-plan .pl-risks { display: grid; gap: 8px; margin-top: 12px; }
    @media (max-width: 480px) { .fragment-plan .pl-files th:nth-child(3), .fragment-plan .pl-files td:nth-child(3) { display: none; } }
  </style>

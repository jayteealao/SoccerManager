 });
 
+test('at one times speed a stalled frame delays playback instead of skipping', () => {
+  const scheduler = new Scheduler();
+  let stalledStep = null;
+  let stalledBefore = null;
+  const rows = captured(() => {
+    // Sixty hertz frames with one 100 millisecond stall early on, as when the first
+    // stream burst decodes; the stall would otherwise carry the cursor five ticks.
+    let timestamp = 0;
+    let lastFrom = 0;
+    for (let frame = 0; frame < 180; frame += 1) {
+      const stalled = frame === 3;
+      timestamp += stalled ? 100 : 1000 / 60;
+      const step = scheduler.advance(timestamp, 100000);
+      if (stalled) {
+        stalledStep = step;
+        stalledBefore = lastFrom;
+      }
+      lastFrom = step.from;
+    }
+  });
+  assert.equal(stalledStep.skipped, 0);
+  assert.ok(stalledStep.from - stalledBefore <= 1, `moved ${stalledStep.from - stalledBefore}`);
+  assert.ok(stalledStep.fraction >= 0 && stalledStep.fraction <= 1);
+  assert.equal(rows.filter((r) => r.signal === 'viewer.tick_skipped').length, 0);
+});
+

+  refreshHz() {
+    if (this.durations.length < 10) {
+      return 60;
+    }
+    const fastest = percentile([...this.durations].sort((a, b) => a - b), 0.1);
+    return fastest > 0 ? 1000 / fastest : 60;
+  }

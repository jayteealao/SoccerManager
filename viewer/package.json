{
  "name": "touchline-viewer",
  "version": "0.1.0",
  "private": true,
  "description": "The match viewer, built with Svelte 5 and Vite. Its looks are skins chosen by the viewer.skin slot.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "vite build",
    "build:release": "vite build --mode release",
    "preview": "vite preview",
    "test": "vitest run",
    "scan": "node scripts/token-scan.mjs",
    "contrast": "node scripts/contrast.mjs",
    "notices:crates": "node scripts/notices.mjs crates",
    "notices:verify": "node scripts/notices.mjs verify"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@testing-library/svelte": "5.4.2",
    "jsdom": "30.1.1",
    "svelte": "5.57.1",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}

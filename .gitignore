*.smfx

# The one-minute replay file the page tests read, written by `engine-cli record`.
!web/tests/data/*.smfx

# The browser suite: its install and its output.
e2e/node_modules/
e2e/test-results/
e2e/playwright-report/

# Release builds: staged folders, setup files, archives, and smoke-test evidence.
dist/

# Workflow test evidence: hundreds of thousands of generated files and browser profiles.
.ai/workflows/**/implement-evidence/
.ai/workflows/**/verify-evidence/
**/.profiles/

# sdlc-workflow artifacts: local only. The project-level contracts stay tracked.
.ai/*
!.ai/ship-plan.md
!.ai/sdlc-config.json
!.ai/observability.md
!.ai/release-announcement-template.md
!.ai/pipeline-compliance.md

# Local notes, research, and reference images: kept on this PC, never tracked.
/inspo/
/docs/research/
/docs/design/realism/
/%SystemDrive%/

# The viewer project: its install and its build.
viewer/node_modules/
viewer/dist/

{
  "game_state": {
    "max_rules": 6,
    "run_of_play_window_min": 15,
    "take_up_s": 30.0,
    "conditions": [
      { "kind": "score", "unit": "goals", "min": 1.0, "max": 5.0 },
      { "kind": "time_left", "unit": "minutes", "min": 1.0, "max": 45.0 },
      { "kind": "red_cards_ours", "unit": "players", "min": 1.0, "max": 4.0 },
      { "kind": "red_cards_theirs", "unit": "players", "min": 1.0, "max": 4.0 },
      { "kind": "run_of_play", "unit": "xg", "min": -5.0, "max": 5.0 },
      { "kind": "team_energy", "unit": "share", "min": 0.05, "max": 1.0 }
    ],
    "player_overrides": [
      { "primitive": "dribbling", "inputs": ["dribble"] },
      { "primitive": "crossing", "inputs": ["crossing"] },
      { "primitive": "cross_type", "inputs": ["early_cross", "cross_loft"] },
      { "primitive": "final_third", "inputs": ["long_shot", "shot_reach_m"] },
      { "primitive": "forward_runs", "inputs": ["run_start_m"], "positions": ["LW", "RW", "ST"] },
      { "primitive": "width", "inputs": ["width", "wide_target"] },
      { "primitive": "pressing", "inputs": ["press_distance", "press_willingness"] },
      { "primitive": "tackling", "inputs": ["tackle_willingness", "tackle_risk"] },
      { "primitive": "on_winning_the_ball", "inputs": ["counter", "pace_lift"] },
      { "primitive": "on_losing_the_ball", "inputs": ["counter_press"] }
    ]
  }
}

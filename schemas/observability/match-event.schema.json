{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://touchline.local/schemas/observability/match-event.schema.json",
  "title": "match-event",
  "description": "One engine event as it happens: a row of matches/<match.id>/events.jsonl, or of events/<match.id>.jsonl in a calibration run folder. Keys are the observability contract's dotted vocabulary; additive extras are allowed.",
  "type": "object",
  "required": [
    "record.kind",
    "schema.version",
    "owner.id",
    "service",
    "version",
    "build.hash",
    "env",
    "operation",
    "match.id",
    "tick",
    "minute",
    "event.type",
    "home.score",
    "away.score"
  ],
  "properties": {
    "record.kind": {
      "const": "match-event"
    },
    "schema.version": {
      "const": "1"
    },
    "owner.id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "service": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "build.hash": {
      "type": "string",
      "minLength": 1
    },
    "env": {
      "type": "string",
      "minLength": 1
    },
    "operation": {
      "type": "string",
      "minLength": 1
    },
    "match.id": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}-[0-9]+$"
    },
    "tick": {
      "type": "integer",
      "minimum": 0
    },
    "minute": {
      "type": "integer",
      "minimum": 0
    },
    "minute.added": {
      "type": "integer",
      "minimum": 0
    },
    "event.type": {
      "enum": [
        "kick-off",
        "goal",
        "shot",
        "pass",
        "foul",
        "card",
        "corner",
        "throw-in",
        "goal-kick",
        "free-kick",
        "penalty",
        "offside",
        "injury",
        "substitution",
        "tactics-change",
        "ai-decision",
        "snapshot",
        "lag",
        "half-time",
        "full-time",
        "error"
      ]
    },
    "team.id": {
      "type": "string",
      "minLength": 1
    },
    "player.id": {
      "type": "string",
      "minLength": 1
    },
    "player.secondary_id": {
      "type": "string",
      "minLength": 1
    },
    "home.score": {
      "type": "integer",
      "minimum": 0
    },
    "away.score": {
      "type": "integer",
      "minimum": 0
    },
    "card.kind": {
      "enum": [
        "yellow",
        "second-yellow",
        "red"
      ]
    },
    "foul.advantage": {
      "type": "boolean"
    },
    "added_time.s": {
      "type": "integer",
      "minimum": 0
    },
    "ai.decision": {
      "type": "string",
      "minLength": 1
    },
    "change.kind": {
      "enum": [
        "tactics",
        "substitution"
      ]
    },
    "change.state": {
      "type": "string",
      "minLength": 1
    },
    "change.queue_id": {
      "type": "string",
      "minLength": 1
    },
    "change.queued_tick": {
      "type": "integer",
      "minimum": 0
    },
    "change.applied_tick": {
      "type": "integer",
      "minimum": 0
    },
    "change.rejected_reason": {
      "type": "string"
    },
    "commentary": {
      "type": "string"
    },
    "period": {
      "type": "integer",
      "minimum": 0
    },
    "shootout.round": {
      "type": "integer",
      "minimum": 1
    },
    "shootout.scored": {
      "type": "boolean"
    },
    "shootout.scores": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      },
      "minItems": 2,
      "maxItems": 2
    },
    "result.decided_by": {
      "enum": [
        "regulation",
        "extra-time",
        "shoot-out"
      ]
    }
  },
  "additionalProperties": true
}

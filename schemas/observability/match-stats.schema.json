{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://touchline.local/schemas/observability/match-stats.schema.json",
  "title": "match-stats",
  "description": "One wide record per match: matches/<match.id>/stats.json, or stats/<match.id>.json in a calibration run folder. Per-team arrays are home first. Additive extras are allowed.",
  "type": "object",
  "required": [
    "record.kind",
    "schema.version",
    "owner.id",
    "service",
    "version",
    "build.hash",
    "env",
    "operation",
    "match.id",
    "seed",
    "content.hash",
    "outcome",
    "duration_ms"
  ],
  "properties": {
    "record.kind": {
      "const": "match-stats"
    },
    "schema.version": {
      "const": "1"
    },
    "owner.id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "service": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "build.hash": {
      "type": "string",
      "minLength": 1
    },
    "env": {
      "type": "string",
      "minLength": 1
    },
    "operation": {
      "type": "string",
      "minLength": 1
    },
    "match.id": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}-[0-9]+$"
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "content.hash": {
      "type": "string"
    },
    "outcome": {
      "description": "error marks a run or match that failed; it then carries the three error.* keys and need not carry statistics.",
      "enum": [
        "success",
        "error"
      ]
    },
    "error.type": {
      "type": "string",
      "minLength": 1
    },
    "error.code": {
      "description": "One code per engine error variant, finer than error.type.",
      "type": "string",
      "minLength": 1
    },
    "error.retriable": {
      "description": "true when the same run may succeed if tried again.",
      "type": "boolean"
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "engine.ticks_per_s": {
      "type": "number",
      "minimum": 0
    },
    "validate.ran": {
      "type": "boolean"
    },
    "validate.violations": {
      "type": "integer",
      "minimum": 0
    },
    "stats.goals": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      },
      "minItems": 2,
      "maxItems": 2
    },
    "stats.shots": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      },
      "minItems": 2,
      "maxItems": 2
    },
    "stats.shots_on_target": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      },
      "minItems": 2,
      "maxItems": 2
    },
    "stats.xg": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 0
      },
      "minItems": 2,
      "maxItems": 2
    },
    "stats.passes": {
      "description": "Open-play passes played, home first. A clearance and a restart kick are not passes.",
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      },
      "minItems": 2,
      "maxItems": 2
    },
    "stats.clearances": {
      "description": "Clearances, home first: a carrier's clearance and a defender's clearance of a fast pass in his own penalty area.",
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      },
      "minItems": 2,
      "maxItems": 2
    },
    "stats.restart_kicks": {
      "description": "Restart kicks, home first: a restart taker's first kick before anyone else touches the ball, at a kick-off, a throw-in, a corner, a goal kick or a free kick.",
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      },
      "minItems": 2,
      "maxItems": 2
    },
    "stats.ball_in_play_s": {
      "description": "Whole seconds with the ball in play over the whole match, the shoot-out excluded.",
      "type": "integer",
      "minimum": 0
    },
    "stats.pass_accuracy_pct": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 100
      },
      "minItems": 2,
      "maxItems": 2
    },
    "stats.possession_pct": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 100
      },
      "minItems": 2,
      "maxItems": 2
    },
    "stats.fouls": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      },
      "minItems": 2,
      "maxItems": 2
    },
    "stats.corners": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      },
      "minItems": 2,
      "maxItems": 2
    },
    "stats.throw_ins": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      },
      "minItems": 2,
      "maxItems": 2
    },
    "stats.goal_kicks": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      },
      "minItems": 2,
      "maxItems": 2
    },
    "stats.offsides": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      },
      "minItems": 2,
      "maxItems": 2
    },
    "rules.pack_version": {
      "type": "integer",
      "minimum": 1
    },
    "fatigue.mean_pct": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "injury.count": {
      "type": "integer",
      "minimum": 0
    },
    "darkpath.change_never_applied": {
      "type": "integer",
      "minimum": 0
    },
    "change.expired_at_full_time": {
      "description": "Changes still waiting at full time because no stoppage that admits their kind opened after they were queued. No zero rule.",
      "type": "integer",
      "minimum": 0
    },
    "manager.kind": {
      "type": "array",
      "items": {
        "enum": [
          "human",
          "ai"
        ]
      },
      "minItems": 2,
      "maxItems": 2
    },
    "extra_time.played": {
      "type": "boolean"
    },
    "extra_time.added_s": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      },
      "minItems": 2,
      "maxItems": 2
    },
    "shootout.scores": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      },
      "minItems": 2,
      "maxItems": 2
    },
    "shootout.kicks": {
      "type": "integer",
      "minimum": 0
    },
    "tuning.flags_on": {
      "description": "The feature flags of the tuning file that were on, sorted by name.",
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "result.decided_by": {
      "enum": [
        "regulation",
        "extra-time",
        "shoot-out"
      ]
    },
    "script.pack": {
      "description": "The script pack the match ran with: id@version+hash. Absent without a pack.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*@[^+]+[+][0-9a-f]{12}$"
    },
    "script.calls": {
      "description": "Script hook calls made, every hook; counted from the resume tick on a resumed match.",
      "type": "integer",
      "minimum": 0
    },
    "script.aborts": {
      "type": "integer",
      "minimum": 0
    },
    "script.denials": {
      "type": "integer",
      "minimum": 0
    },
    "script.disabled": {
      "description": "Hooks switched off after three failures in a row.",
      "type": "integer",
      "minimum": 0
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "error"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "required": [
          "error.type",
          "error.code",
          "error.retriable"
        ]
      },
      "else": {
        "required": [
          "engine.ticks_per_s",
          "validate.ran",
          "validate.violations",
          "stats.goals",
          "stats.shots",
          "stats.shots_on_target",
          "stats.xg",
          "stats.passes",
          "stats.pass_accuracy_pct",
          "stats.possession_pct",
          "stats.fouls",
          "stats.corners",
          "stats.throw_ins",
          "stats.goal_kicks",
          "stats.offsides",
          "rules.pack_version",
          "fatigue.mean_pct",
          "injury.count",
          "darkpath.change_never_applied",
          "change.expired_at_full_time",
          "manager.kind"
        ]
      }
    }
  ],
  "additionalProperties": true
}

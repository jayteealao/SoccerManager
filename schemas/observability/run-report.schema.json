{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://touchline.local/schemas/observability/run-report.schema.json",
  "title": "run-report",
  "description": "One record per benchmark or calibration run. A calibration run writes it as runs/<run.id>/report.json and prints it. Additive extras are allowed.",
  "type": "object",
  "required": [
    "record.kind",
    "schema.version",
    "owner.id",
    "service",
    "version",
    "build.hash",
    "env",
    "operation",
    "run.id",
    "seed",
    "content.hash",
    "outcome",
    "machine.hash"
  ],
  "properties": {
    "record.kind": {
      "const": "run-report"
    },
    "schema.version": {
      "description": "1 for a benchmark run and for calibrate runs before the band registry; 2 for a calibrate run with the registry, the verdicts and the stage costs; 3 for a calibrate run whose rules stage reports its rows; 4 for a calibrate run that reports each band's real value (calib.real, calib.realism, and the real columns of each verdict); 5 for a calibrate run that reports the bands that only report apart (calib.reported), the developer's acceptances (calib.accepted), the match counts (calib.counts), and how each verdict row was judged; 6 for a calibrate run with the whole-distribution bands (upper and noise_floor on a verdict row); 7 for a calibrate run with the formation field rating (calib.nash). Every key of an older version stays.",
      "enum": ["1", "2", "3", "4", "5", "6", "7"]
    },
    "owner.id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "service": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "build.hash": {
      "type": "string",
      "minLength": 1
    },
    "env": {
      "type": "string",
      "minLength": 1
    },
    "operation": {
      "enum": [
        "benchmark",
        "calibrate"
      ]
    },
    "run.id": {
      "type": "string",
      "minLength": 1
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "content.hash": {
      "type": "string"
    },
    "fixtures.hash": {
      "description": "A calibration run: SHA-256 (12 hex characters) over the inputs that decide the fixtures: the attributes, rules and tactics content, the generator block after flag states, and the two default clubs. A baseline must share it.",
      "type": "string",
      "pattern": "^[0-9a-f]{12}$"
    },
    "fixtures.scheme": {
      "description": "A calibration run: the scheme its fixture keys and engine seeds are made by. A report without it is from the old seeding scheme, whose match seeds came from the fixture's place in the run; it cannot be a baseline.",
      "type": "string",
      "minLength": 1
    },
    "run.identity": {
      "description": "A calibration run: everything that makes its results what they are (build, content, fixtures, flags, paired flag, seed, minutes, strength boost, random-number scheme, fixture scheme, measures version, registry version), as the run folder's run.json holds it.",
      "type": "object"
    },
    "outcome": {
      "description": "error marks a run or match that failed; it then carries the three error.* keys and need not carry statistics.",
      "enum": [
        "success",
        "error"
      ]
    },
    "error.type": {
      "type": "string",
      "minLength": 1
    },
    "error.code": {
      "description": "One code per engine error variant, finer than error.type.",
      "type": "string",
      "minLength": 1
    },
    "error.retriable": {
      "description": "true when the same run may succeed if tried again.",
      "type": "boolean"
    },
    "machine.hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{12}$"
    },
    "machine.cpu_model": {
      "type": "string"
    },
    "bench.match_wall_ms": {
      "type": "integer",
      "minimum": 0
    },
    "bench.cpu_us_per_tick": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "bench.peak_mem_mb": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "bench.matches": {
      "type": "integer",
      "minimum": 1
    }
  },
  "$defs": {
    "verdictRow": {
      "type": "object",
      "required": ["band", "suite", "word", "value", "lo", "hi"],
      "properties": {
        "band": { "type": "string", "minLength": 1 },
        "suite": { "enum": ["equal", "strength", "formations", "red-card"] },
        "pairing": { "type": "string" },
        "word": { "enum": ["pass", "fail", "not sure"] },
        "value": { "type": "number" },
        "lo": { "type": "number" },
        "hi": { "type": "number" },
        "base_value": { "type": "number" },
        "diff": { "type": "number" },
        "se": { "type": "number", "minimum": 0 },
        "smallest_shift": { "type": "number", "exclusiveMinimum": 0 },
        "power": { "type": "boolean" },
        "needed": { "type": "integer", "minimum": 0 },
        "outside_by": {
          "description": "A change run: how far the changed engine's value is outside its range, when its range check fails.",
          "type": "number",
          "minimum": 0
        },
        "no_target": {
          "description": "A change run: the band was outside its range by more than its noise at the pilot (beyond the joint threshold times its own error), so it set no power target. Its word is judged as for any band.",
          "const": true
        },
        "real": {
          "description": "The band's real value, read in place from the real-data folder; absent when the band has none here. It never changes the word.",
          "type": "number"
        },
        "distance": {
          "description": "The run's value minus the real value; for a whole-distribution band (its real column reads whole sample), the distance of the run's whole sample from the real one, which is also its value.",
          "type": "number"
        },
        "upper": {
          "description": "Since version 6: a whole-distribution band's one-sided upper bound, the 97th percentile of its whole-match resampled distance; the band passes when it is within the margin (hi).",
          "type": "number",
          "minimum": 0
        },
        "noise_floor": {
          "description": "Since version 6: a whole-distribution band's noise floor, the 97th percentile of its centred resampled distance: about the distance a perfect engine shows at these sample sizes. A margin at or under it can never pass (margin below noise floor).",
          "type": "number",
          "minimum": 0
        },
        "report_only": {
          "description": "Why the band only reports (gates false in the band file, a real sample under its floor, or a generalisation under the floor): its word is shown, but it is left out of the joint word and of calib.pass.",
          "type": "string",
          "minLength": 1
        },
        "judged": {
          "description": "Since version 5: paired, by the paired max-t test against the old engine; or range, by its range on this engine alone, with se its own standard error: fail outside the range, pass inside with the nearest edge at least 2.1701 errors away, not sure otherwise. Absent for a gating row of a run without an old engine.",
          "enum": ["paired", "range"]
        },
        "note": {
          "description": "Since version 5: why the row was judged as it was, or has no value (range only: base has no measures; range only: a per-club spread has no paired test; this build has no measures; no value: ...; acceptance no longer applies: ...).",
          "type": "string",
          "minLength": 1
        },
        "accepted": {
          "description": "Since version 5: the developer accepted this not-sure row in the run folder's accepted.json. It is accepted, not shown equivalent: its word stays not sure and it never counts as a pass.",
          "const": true
        }
      }
    },
    "ruleInterval": {
      "description": "An estimate and its 95 percent interval.",
      "type": "object",
      "required": ["est", "lo", "hi"],
      "properties": {
        "est": { "type": "number" },
        "lo": { "type": "number" },
        "hi": { "type": "number" }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "error"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "required": [
          "error.type",
          "error.code",
          "error.retriable"
        ]
      },
      "else": {
        "required": [
          "bench.match_wall_ms",
          "bench.cpu_us_per_tick",
          "bench.peak_mem_mb"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "benchmark"
          },
          "outcome": {
            "not": {
              "const": "error"
            }
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "required": [
          "bench.matches",
          "bench.ticks_per_match",
          "budget.pass"
        ],
        "properties": {
          "budget.pass": {
            "type": "boolean"
          },
          "script.pack": {
            "description": "The script pack every timed match ran with: id@version+hash. Absent without a pack.",
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*@[^+]+[+][0-9a-f]{12}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "calibrate"
          },
          "outcome": {
            "not": {
              "const": "error"
            }
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "required": [
          "calib.matches",
          "calib.minutes",
          "calib.jobs",
          "calib.suites",
          "calib.wall_ms",
          "calib.bands",
          "calib.pass",
          "darkpath.change_never_applied",
          "change.expired_at_full_time",
          "darkpath.match_without_stats",
          "validate.violations",
          "events.files_written",
          "events.files_kept",
          "machine.cpu_model"
        ],
        "properties": {
          "calib.matches": {
            "type": "integer",
            "minimum": 1
          },
          "calib.minutes": {
            "type": "integer",
            "minimum": 1
          },
          "calib.jobs": {
            "type": "integer",
            "minimum": 1
          },
          "calib.suites": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": {
              "enum": [
                "equal",
                "strength",
                "formations",
                "red-card"
              ]
            },
            "additionalProperties": {
              "type": "object",
              "required": [
                "matches",
                "recorded",
                "failures",
                "goals_per_match_mean",
                "shots_per_team_mean",
                "possession_home_mean",
                "possession_away_mean",
                "ten_plus_goals_share",
                "goalless_share",
                "sending_off_share",
                "yellow_cards_per_team_mean",
                "shots_on_target_share",
                "goals_per_xg",
                "corners_per_team_mean",
                "throw_ins_per_match_mean",
                "goal_kicks_per_match_mean"
              ],
              "properties": {
                "ten_plus_goals_share": { "type": "number", "minimum": 0, "maximum": 1 },
                "goalless_share": { "type": "number", "minimum": 0, "maximum": 1 },
                "sending_off_share": { "type": "number", "minimum": 0, "maximum": 1 },
                "yellow_cards_per_team_mean": { "type": "number", "minimum": 0 },
                "shots_on_target_share": { "type": "number", "minimum": 0, "maximum": 1 },
                "goals_per_xg": { "type": "number", "minimum": 0 },
                "corners_per_team_mean": { "type": "number", "minimum": 0 },
                "throw_ins_per_match_mean": { "type": "number", "minimum": 0 },
                "goal_kicks_per_match_mean": { "type": "number", "minimum": 0 },
                "ball_in_play_min_per_90_mean": { "type": "number", "minimum": 0 }
              }
            }
          },
          "calib.wall_ms": {
            "type": "object",
            "required": [
              "total"
            ],
            "additionalProperties": {
              "type": "integer",
              "minimum": 0
            }
          },
          "calib.bands": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "band",
                "suite",
                "value",
                "lo",
                "hi",
                "pass"
              ],
              "properties": {
                "band": {
                  "type": "string"
                },
                "suite": {
                  "enum": [
                    "equal",
                    "strength",
                    "formations",
                    "red-card"
                  ]
                },
                "pairing": {
                  "description": "The formation pairing of a formations-suite check, for example 4-3-3 v 4-4-2, or the arm of a red-card check (keeper, centre-back, striker).",
                  "type": "string",
                  "minLength": 1
                },
                "value": {
                  "type": "number"
                },
                "lo": {
                  "type": "number"
                },
                "hi": {
                  "type": "number"
                },
                "pass": {
                  "type": "boolean"
                },
                "se": {
                  "description": "The sampling error of value: the standard error of a mean, share, or ratio over the matches judged; 0 for wall_ms.",
                  "type": "number",
                  "minimum": 0
                },
                "informational": {
                  "description": "A change run only: true on a formations check of one pairing. The change run judges and powers each formations band pooled over every pairing, so this row sets no power target and does not enter the joint verdict. Absent in a plain run.",
                  "const": true
                }
              }
            }
          },
          "calib.formations": {
            "description": "The figures of every formation pairing of the formations suite. Absent when that suite did not run.",
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "pairing",
                "matches",
                "goals_per_match_mean",
                "goals_for_mean",
                "ten_plus_goals_share",
                "goalless_share"
              ],
              "properties": {
                "pairing": {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1 },
                  "minItems": 2,
                  "maxItems": 2
                },
                "matches": { "type": "integer", "minimum": 0 },
                "goals_per_match_mean": { "type": "number", "minimum": 0 },
                "goals_for_mean": {
                  "type": "array",
                  "items": { "type": "number", "minimum": 0 },
                  "minItems": 2,
                  "maxItems": 2
                },
                "ten_plus_goals_share": { "type": "number", "minimum": 0, "maximum": 1 },
                "goalless_share": { "type": "number", "minimum": 0, "maximum": 1 }
              }
            }
          },
          "calib.nash": {
            "description": "Since version 7: the formation field rating of the formations suite, report only; it never changes the verdict, calib.pass or the exit code. Each formation's win_rate is its mean win share over every formation of the field, itself included (a draw is not a win); its field_rating is the same win share weighted by the maximum-entropy Nash equilibrium of the payoff table wins minus losses (weight); nash_average is that table times the equilibrium, as Nash averaging defines it (0 inside the equilibrium's support, at most 0 outside it). A formation is flagged when its field rating exceeds its win rate by more than flag_margin. converged is false when the solve stopped at its iteration cap; matches_per_pairing is the fewest finished matches of a pairing. Absent unless every pairing of the formations suite finished a match, and in a paired run it describes the off arm, as calib.formations does.",
            "type": "object",
            "required": ["flag_margin", "converged", "iterations", "matches_per_pairing", "formations"],
            "additionalProperties": false,
            "properties": {
              "flag_margin": { "type": "number", "minimum": 0 },
              "converged": { "type": "boolean" },
              "iterations": { "type": "integer", "minimum": 0 },
              "matches_per_pairing": { "type": "integer", "minimum": 0 },
              "formations": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["formation", "weight", "win_rate", "field_rating", "nash_average", "flagged"],
                  "additionalProperties": false,
                  "properties": {
                    "formation": { "type": "string", "minLength": 1 },
                    "weight": { "type": "number", "minimum": 0, "maximum": 1 },
                    "win_rate": { "type": "number", "minimum": 0, "maximum": 1 },
                    "field_rating": { "type": "number", "minimum": 0, "maximum": 1 },
                    "nash_average": { "type": "number" },
                    "flagged": { "type": "boolean" }
                  }
                }
              }
            }
          },
          "calib.pass": {
            "description": "The run's answer, as the exit code gives it: in a change run, true only when calib.joint.word is pass; otherwise every band check, the time budget included, passes and no dark-path counter is set.",
            "type": "boolean"
          },
          "calib.selection": {
            "description": "What the run selected: the suites played, the formation pairings (empty when every pairing played), and the bands judged (empty when every band was judged).",
            "type": "object",
            "required": ["suites", "pairings", "bands"],
            "properties": {
              "suites": {
                "type": "array",
                "items": { "enum": ["equal", "strength", "formations", "red-card"] }
              },
              "pairings": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "bands": { "type": "array", "items": { "type": "string", "minLength": 1 } }
            }
          },
          "calib.red_card": {
            "description": "The controlled sending-off experiment: mean goals per match of the control and of each arm's full (home) and reduced (away) side, the limit (1.6 times the control's home mean), and the criterion verdict. Absent when the red-card suite did not run.",
            "type": "object",
            "required": ["matches", "control", "control_matches", "arms", "limit", "pass"],
            "properties": {
              "matches": { "type": "integer", "minimum": 1 },
              "control": {
                "type": "array",
                "items": { "type": "number", "minimum": 0 },
                "minItems": 2,
                "maxItems": 2
              },
              "control_matches": { "type": "integer", "minimum": 0 },
              "arms": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["arm", "player", "matches", "full", "reduced", "pass"],
                  "properties": {
                    "arm": { "enum": ["keeper", "centre-back", "striker"] },
                    "player": { "type": "integer", "minimum": 0 },
                    "matches": { "type": "integer", "minimum": 0 },
                    "full": { "type": "number", "minimum": 0 },
                    "reduced": { "type": "number", "minimum": 0 },
                    "pass": { "type": "boolean" }
                  }
                }
              },
              "limit": { "type": "number", "minimum": 0 },
              "pass": { "type": "boolean" }
            }
          },
          "calib.baseline": {
            "description": "The earlier report the run was compared with (--baseline).",
            "type": "object",
            "required": ["path", "run.id", "seed", "content.hash"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "run.id": { "type": "string" },
              "seed": { "type": "integer", "minimum": 0 },
              "content.hash": { "type": "string" }
            }
          },
          "calib.diff": {
            "description": "One row per band, pairing, and arm both runs judged: the baseline and new values, the change, its sampling error, and whether the change is inside two errors (noise).",
            "type": "object",
            "required": ["content_hashes", "content_changed", "rows", "noise", "changes"],
            "properties": {
              "content_hashes": {
                "type": "array",
                "items": { "type": "string" },
                "minItems": 2,
                "maxItems": 2
              },
              "content_changed": { "type": "boolean" },
              "noise": { "type": "integer", "minimum": 0 },
              "changes": { "type": "integer", "minimum": 0 },
              "rows": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["suite", "band", "baseline", "new", "change", "error", "noise", "pass"],
                  "properties": {
                    "suite": { "enum": ["equal", "strength", "formations", "red-card"] },
                    "band": { "type": "string" },
                    "pairing": { "type": "string", "minLength": 1 },
                    "baseline": { "type": "number" },
                    "new": { "type": "number" },
                    "change": { "type": "number" },
                    "error": { "type": "number", "minimum": 0 },
                    "noise": { "type": "boolean" },
                    "pass": { "type": "boolean" }
                  }
                }
              }
            }
          },
          "darkpath.change_never_applied": {
            "type": "integer",
            "minimum": 0
          },
          "change.expired_at_full_time": {
            "description": "Changes still waiting at full time because no stoppage that admits their kind opened after they were queued. No zero rule.",
            "type": "integer",
            "minimum": 0
          },
          "darkpath.match_without_stats": {
            "type": "integer",
            "minimum": 0
          },
          "validate.violations": {
            "type": "integer",
            "minimum": 0
          },
          "events.files_written": {
            "type": "integer",
            "minimum": 0
          },
          "events.files_kept": {
            "type": "integer",
            "minimum": 0
          },
          "calib.flags": {
            "description": "Every feature flag the tuning file declares, with its state for this run.",
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "owner",
                "state",
                "source"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "owner": {
                  "type": "string"
                },
                "state": {
                  "enum": [
                    "on",
                    "off",
                    "paired"
                  ]
                },
                "source": {
                  "enum": [
                    "file",
                    "cli"
                  ]
                }
              }
            }
          },
          "calib.pair": {
            "description": "A paired run: the flag compared. The top-level figures describe the off arm.",
            "type": "object",
            "required": [
              "flag",
              "owner",
              "hypothesis",
              "removal_condition",
              "pinned"
            ],
            "properties": {
              "flag": {
                "type": "string"
              },
              "owner": {
                "type": "string",
                "minLength": 1
              },
              "hypothesis": {
                "type": "string",
                "minLength": 1
              },
              "removal_condition": {
                "type": "string",
                "minLength": 1
              },
              "pinned": {
                "type": "object",
                "additionalProperties": {
                  "enum": [
                    "on",
                    "off"
                  ]
                }
              }
            }
          },
          "calib.arms": {
            "type": "object",
            "required": [
              "off",
              "on"
            ],
            "additionalProperties": {
              "type": "object",
              "required": [
                "content.hash",
                "tuning.flags_on",
                "calib.suites",
                "calib.wall_ms",
                "calib.bands",
                "calib.pass",
                "darkpath.change_never_applied",
                "darkpath.match_without_stats",
                "validate.violations",
                "bench.match_wall_ms"
              ],
              "properties": {
                "calib.workers_failed": {
                  "description": "Always 0. Matches no longer run in worker processes, so no worker can fail. The field is kept so saved reports stay readable.",
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          },
          "calib.compare": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "suite",
                "band",
                "lo",
                "hi",
                "off",
                "on",
                "delta",
                "off_pass",
                "on_pass"
              ],
              "properties": {
                "suite": {
                  "enum": [
                    "equal",
                    "strength",
                    "formations",
                    "red-card"
                  ]
                },
                "band": {
                  "type": "string"
                },
                "pairing": {
                  "type": "string",
                  "minLength": 1
                },
                "lo": {
                  "type": "number"
                },
                "hi": {
                  "type": "number"
                },
                "off": {
                  "type": "number"
                },
                "on": {
                  "type": "number"
                },
                "delta": {
                  "type": "number"
                },
                "off_pass": {
                  "type": "boolean"
                },
                "on_pass": {
                  "type": "boolean"
                }
              }
            }
          },
          "calib.verdict": {
            "enum": [
              "on-rejected",
              "on-better",
              "off-better",
              "no-difference"
            ]
          },
          "calib.units": {
            "description": "The run's fixtures over every arm and suite, those an earlier session of the run had finished, and those this session played.",
            "type": "object",
            "required": ["total", "finished_before", "played"],
            "properties": {
              "total": { "type": "integer", "minimum": 0 },
              "finished_before": { "type": "integer", "minimum": 0 },
              "played": { "type": "integer", "minimum": 0 }
            }
          },
          "calib.results_digest": {
            "description": "SHA-256 over every arm's compact rows in fixture-key order: each row's key and its columns except record.reasons and duration_us. A resumed run gives the same digest as an uninterrupted one. Reports of earlier builds hashed each match's statistics instead, so their digests are not comparable with these.",
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "darkpath.match_panicked": {
            "description": "Matches that panicked; the run caught each one, recorded it as failed, and went on.",
            "type": "integer",
            "minimum": 0
          },
          "calib.runner": {
            "description": "threads: the one-process runner. processes appears only in reports of earlier builds, which also had worker processes.",
            "enum": ["threads", "processes"]
          },
          "calib.rows": {
            "description": "The compact rows of every arm: the row format, the row files, the rows the ledger counts, and the matches with a full recording (statistics and event file), by reason; a match can have more than one reason.",
            "type": "object",
            "required": ["format", "files", "rows", "recorded"],
            "properties": {
              "format": { "type": "integer", "minimum": 1 },
              "measures": {
                "description": "true when the build records the realism measures (built with the measures feature); absent in reports of earlier builds.",
                "type": "boolean"
              },
              "files": { "type": "integer", "minimum": 0 },
              "rows": { "type": "integer", "minimum": 0 },
              "recorded": {
                "type": "object",
                "required": ["matches", "sample", "error", "violation", "extreme", "all"],
                "additionalProperties": { "type": "integer", "minimum": 0 }
              }
            }
          },
          "calib.verdicts": {
            "description": "Each band's word. In a change run it comes from the paired max-t test: fail when the value is outside the range or the change is beyond the joint threshold and at least the band's smallest shift, pass when inside, not a fail, and with the power to see the band's smallest shift, not sure otherwise. In a run without an old engine it is the range check, without the time budget (wall_ms), which calib.pass still includes. A change-run row outside its range carries outside_by; one that set no power target carries no_target.",
            "type": "array",
            "items": { "$ref": "#/$defs/verdictRow" }
          },
          "calib.reported": {
            "description": "Since version 5: the rows of the bands that only report (gates false, a real sample under its floor, or a generalisation under the floor), each judged by the same rules as a gating band, with the same keys as calib.verdicts. They never enter the joint word, calib.pass, calib.bands or a suite's power target.",
            "type": "array",
            "items": { "$ref": "#/$defs/verdictRow" }
          },
          "calib.accepted": {
            "description": "Since version 5: the run folder's accepted.json, the bands it accepts, and why it was ignored when it was (another run or identity, or a file that cannot be read).",
            "type": "object",
            "required": ["file", "bands"],
            "properties": {
              "file": { "type": "string", "minLength": 1 },
              "bands": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "ignored": { "type": "string", "minLength": 1 }
            }
          },
          "calib.counts": {
            "description": "Since version 5: the matches the run judged: every engine's rows in total, the fixtures both engines of a change run played (0 otherwise), and each engine's matches: changed and old in a change run, this otherwise, each with its build.",
            "type": "object",
            "required": ["total_matches", "pairs", "observations"],
            "properties": {
              "total_matches": { "type": "integer", "minimum": 0 },
              "pairs": { "type": "integer", "minimum": 0 },
              "observations": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["engine", "build", "matches"],
                  "properties": {
                    "engine": { "enum": ["changed", "old", "this"] },
                    "build": { "type": "string", "minLength": 1 },
                    "matches": { "type": "integer", "minimum": 0 }
                  }
                }
              }
            }
          },
          "calib.joint": {
            "description": "A change run's joint verdict: fail when any band fails or any match panicked, missed its result, left a change unapplied, or broke a rule; pass when every band passes; not sure otherwise. critical is the max-t threshold over the resamples.",
            "type": "object",
            "required": ["word", "critical", "resamples", "false_alarm", "pairs"],
            "properties": {
              "word": { "enum": ["pass", "fail", "not sure"] },
              "critical": { "type": "number", "minimum": 0 },
              "resamples": { "type": "integer", "minimum": 1 },
              "false_alarm": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 },
              "pairs": { "type": "integer", "minimum": 0 },
              "guards": { "type": "array", "items": { "type": "string" } }
            }
          },
          "calib.power": {
            "description": "A change run, per suite: the pilot's matches per suite unit, the power target played, the cap (--matches), whether every band of the suite reached its power, the band that set the target, and the bands that set none because they were outside their range by more than their noise at the pilot.",
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": ["target", "cap", "reached"],
              "properties": {
                "pilot": { "type": "integer", "minimum": 1 },
                "target": { "type": "integer", "minimum": 1 },
                "cap": { "type": "integer", "minimum": 1 },
                "reached": { "type": "boolean" },
                "driver": {
                  "description": "The band whose power needed the most matches at the pilot, which set the target. Absent when the pilot gave every band power.",
                  "type": "string",
                  "minLength": 1
                },
                "no_target": {
                  "description": "The bands outside their range by more than their noise at the pilot, which set no target (band, or band/label for a row of one arm). Absent when every band set the target.",
                  "type": "array",
                  "items": { "type": "string", "minLength": 1 }
                }
              }
            }
          },
          "calib.real": {
            "description": "The real-data folder the run read (--real-data, or the main checkout's .scratch/out), whether it exists, the bands without a real value (not read here, or migrated without a record), the bands with no real counterpart (engine experiments, never counted as missing), the folder when it does not exist, and one entry per band with its real value, standard error, record and confidence words.",
            "type": "object",
            "required": ["from", "present", "missing", "no_counterpart", "bands"],
            "properties": {
              "folder": { "type": "string", "minLength": 1 },
              "from": { "enum": ["flag", "default", "not_found"] },
              "present": { "type": "boolean" },
              "missing": { "type": "integer", "minimum": 0 },
              "no_counterpart": { "type": "integer", "minimum": 0 },
              "missing_path": { "type": "string", "minLength": 1 },
              "bands": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["band", "status", "measurement", "generalisation"],
                  "properties": {
                    "band": { "type": "string", "minLength": 1 },
                    "status": { "enum": ["read", "not_here", "no_counterpart", "no_record"] },
                    "value": { "type": "number" },
                    "se": { "type": "number", "minimum": 0 },
                    "file_date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
                    "reason": { "type": "string", "minLength": 1 },
                    "source": {
                      "description": "A pointer (dataset, file, key, and how to reduce it) or a no-counterpart record (none, with its reason).",
                      "type": "object"
                    },
                    "sample": { "type": "integer", "minimum": 0 },
                    "date": { "type": "string", "minLength": 1 },
                    "evidence": { "enum": ["calibration", "validation"] },
                    "measurement": {
                      "type": "object",
                      "required": ["word"],
                      "properties": {
                        "count": { "type": "integer", "minimum": 0 },
                        "se": { "type": "number", "minimum": 0 },
                        "word": { "enum": ["precise", "fair", "rough", "unknown", "n/a"] }
                      }
                    },
                    "generalisation": {
                      "type": "object",
                      "required": ["word"],
                      "properties": {
                        "competitions": { "type": "integer", "minimum": 0 },
                        "seasons": { "type": "integer", "minimum": 0 },
                        "clubs": { "type": "integer", "minimum": 0 },
                        "units": { "type": "integer", "minimum": 0 },
                        "word": { "enum": ["broad", "narrow", "thin", "unknown", "n/a"] }
                      }
                    },
                    "report_only": { "type": "string", "minLength": 1 }
                  }
                }
              }
            }
          },
          "calib.realism": {
            "description": "The realism claim: only gating bands with evidence validation and a real counterpart count toward it; calibration bands, which tuning may have read, are counted apart and never toward the claim.",
            "type": "object",
            "required": ["validation_bands", "validation_inside", "calibration_bands", "claim"],
            "properties": {
              "validation_bands": { "type": "integer", "minimum": 0 },
              "validation_inside": { "type": "integer", "minimum": 0 },
              "calibration_bands": { "type": "integer", "minimum": 0 },
              "claim": { "type": "string", "minLength": 1 }
            }
          },
          "calib.registry": {
            "description": "The band registry the run was judged with: its layout version (4 since the band record), the digest of what decides each band's verdict, and the version it was migrated from when it was.",
            "type": "object",
            "required": ["version", "digest"],
            "properties": {
              "version": { "type": "integer", "minimum": 3 },
              "digest": { "type": "string", "pattern": "^[0-9a-f]{12}$" },
              "migrated_from": { "type": "integer", "minimum": 1 }
            }
          },
          "calib.stages": {
            "description": "Time and memory of each stage: play, checks, commentary, writing, disk and judge, as thread time summed over the threads and the largest heap growth of one thread in the stage, and total, the run's wall time and the process's peak working set where the platform gives it.",
            "type": "object",
            "required": ["play", "checks", "commentary", "writing", "disk", "judge", "total"],
            "additionalProperties": {
              "type": "object",
              "required": ["ms", "peak_mb"],
              "properties": {
                "ms": { "type": "integer", "minimum": 0 },
                "peak_mb": { "type": ["number", "null"], "minimum": 0 }
              }
            }
          },
          "calib.rules": {
            "description": "A change run's rules stage: the touched sensitivity rules checked, the levels checked over every rule (two per rule), and the rules judged fail. Since version 3 also the rules judged not sure, whether the build carries the rules (the sensitivity feature), the stage's wall time, and one row per rule with the five-match rule last.",
            "type": "object",
            "required": ["checked", "levels", "failed"],
            "properties": {
              "checked": { "type": "integer", "minimum": 0 },
              "levels": { "type": "integer", "minimum": 0 },
              "failed": { "type": "integer", "minimum": 0 },
              "not_sure": { "type": "integer", "minimum": 0 },
              "built": { "type": "boolean" },
              "ms": { "type": "integer", "minimum": 0 },
              "rows": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["job", "statistic", "levels", "word"],
                  "properties": {
                    "job": { "type": "string", "minLength": 1 },
                    "statistic": { "type": "string", "minLength": 1 },
                    "levels": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
                    "low": { "type": "number" },
                    "high": { "type": "number" },
                    "move": { "$ref": "#/$defs/ruleInterval" },
                    "share": { "$ref": "#/$defs/ruleInterval" },
                    "roles": { "type": "object", "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 } },
                    "word": { "enum": ["pass", "fail", "not_sure"] }
                  }
                }
              }
            }
          },
          "calib.base": {
            "description": "The old engine of a change run: where it came from, its build and content, how many of its results came from the cache and how many it played, and its band rows on the run's fixtures.",
            "type": "object",
            "required": ["source", "build.id", "content.hash", "cache", "calib.bands"],
            "properties": {
              "source": { "enum": ["rev", "binary"] },
              "rev": { "type": "string" },
              "commit": { "type": "string" },
              "build.id": { "type": "string", "minLength": 1 },
              "content.hash": { "type": "string" },
              "cache": {
                "type": "object",
                "required": ["hits", "played"],
                "properties": {
                  "hits": { "type": "integer", "minimum": 0 },
                  "played": { "type": "integer", "minimum": 0 }
                }
              },
              "calib.bands": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["band", "suite", "value", "pass"]
                }
              }
            }
          }
        },
        "dependentRequired": {
          "calib.pair": [
            "calib.arms",
            "calib.compare",
            "calib.verdict"
          ],
          "calib.joint": [
            "calib.verdicts",
            "calib.power",
            "calib.rules",
            "calib.base"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": { "const": "calibrate" },
          "schema.version": { "enum": ["2", "3", "4", "5", "6", "7"] },
          "outcome": { "not": { "const": "error" } }
        },
        "required": ["operation", "schema.version"]
      },
      "then": {
        "required": ["calib.registry", "calib.stages"]
      }
    }
  ],
  "additionalProperties": true
}
